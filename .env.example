# Public branch Auth URL only. Browser requests use the same-origin /api/auth proxy.
VITE_NEON_AUTH_URL=
VITE_VAPID_PUBLIC_KEY=
# Server-only values on Vercel. NEVER prefix secrets with VITE_.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Server-only project-scoped management key for password-confirmed own-account deletion.
PRIVATE_NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
GROQ_API_KEY=
# Choose a production text model available on your actual Groq Free account.
GROQ_MODEL=
GROQ_FREE_CONFIRMED=false
GROQ_ZDR_CONFIRMED=false
